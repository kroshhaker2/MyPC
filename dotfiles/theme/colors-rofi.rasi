/* Central Rofi palette; suitable as a future Pywal template output. */
* {
  background: #0a0c10;
  foreground: #e5edf4;
  cursor: #e5edf4;

  color0: #0a0c10;
  color1: #7ebae4;
  color2: #4c7899;
  color3: #ffbe61;
  color4: #7ebae4;
  color5: #9bd3f7;
  color6: #79c0ff;
  color7: #e5edf4;
  color8: #8998a8;
  color9: #f53c3c;
  color10: #26a65b;
  color11: #ffbe61;
  color12: #9bd3f7;
  color13: #c099ff;
  color14: #89ddff;
  color15: #ffffff;

  surface: #0a0c1080;
  input-surface: #0a0c1033;
  transparent: #00000000;
}
